# Local: docker compose up -d
DATABASE_URL="postgresql://crown:crown_dev_only@localhost:5432/crown"

# First admin created by `npm run db:seed`
SEED_ADMIN_PHONE="01XXXXXXXXX"
SEED_ADMIN_EMAIL="owner@example.com"
SEED_ADMIN_PASSWORD="change-me-to-a-long-password"

# --- Subscription service (optional) ---
# "true" opens /signup so other salons can start a free trial
ALLOW_SIGNUP="false"
# Admin phones that can open /platform (all salons, approve payments)
PLATFORM_ADMIN_PHONES="01XXXXXXXXX"
# bKash number salons send subscription payments to
PLATFORM_BKASH_NUMBER="01XXXXXXXXX"
