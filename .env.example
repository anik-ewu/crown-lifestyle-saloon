# Local: docker compose up -d
DATABASE_URL="postgresql://crown:crown_dev_only@localhost:5432/crown"

# Product name on the sign-in page and browser tabs
NEXT_PUBLIC_APP_NAME="Salon Manager"

# You (the platform owner). `npm run db:seed` creates your workspace and login.
PLATFORM_OWNER_NAME="Your name"
PLATFORM_OWNER_PHONE="01XXXXXXXXX"
PLATFORM_OWNER_EMAIL="you@example.com"
PLATFORM_OWNER_PASSWORD="change-me-to-a-long-password"

# Phones allowed to open /platform (must include PLATFORM_OWNER_PHONE)
PLATFORM_ADMIN_PHONES="01XXXXXXXXX"

# bKash number client salons send subscription payments to
PLATFORM_BKASH_NUMBER="01XXXXXXXXX"

# "true" opens /signup for salons to start a free trial themselves.
# Leave "false" to add every salon yourself from /platform.
ALLOW_SIGNUP="false"

# Local demo only (`npm run db:seed -- --demo`): Crown as a client salon
DEMO_CROWN_OWNER_PHONE="01XXXXXXXXX"
DEMO_CROWN_OWNER_PASSWORD="change-me-to-a-long-password"
